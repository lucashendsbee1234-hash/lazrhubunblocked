{
  "entities": {
    "games": {
      "title": "Games Catalog",
      "description": "Games available for everyone on LAZRHUB",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "iframeUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "rating": { "type": "number" },
        "plays": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "author": { "type": "string" },
        "controls": { "type": "string" }
      },
      "required": ["title", "iframeUrl"]
    },
    "users": {
      "title": "User Profiles",
      "description": "User profile accounts, LazrCoins, XP, level, cosmetics, and achievements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string" },
        "coins": { "type": "number" },
        "xp": { "type": "number" },
        "level": { "type": "number" }
      },
      "required": ["email", "displayName"]
    },
    "siteSettings": {
      "title": "Site Settings",
      "description": "Global configurations including top site announcements and moderation",
      "type": "object",
      "properties": {
        "announcement": { "type": "string" }
      }
    },
    "chatMessages": {
      "title": "Chat Messages",
      "description": "Live chat room messages",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" }
      }
    }
  }
}
